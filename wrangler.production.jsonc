{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptiki-v3",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-27",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "cryptiki.com", "custom_domain": true }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "4002", "simple": { "limit": 30, "period": 60 } },
    { "name": "REQUEST_LIMITER", "namespace_id": "4003", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cryptiki-v3-production",
    "database_id": "3fe48cdc-6813-428a-8194-26f49b16d9eb",
    "migrations_dir": "migrations"
  }]
}
