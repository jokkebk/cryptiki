RewriteEngine On

# Keep one canonical URL for the current application.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect the former current-application URLs to the site root.
RewriteRule ^new(?:\.html|/.*)?$ / [R=301,L,NC]

# Serve real files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Old page-name URLs remain available through the read-only legacy UI.
RewriteRule ^ legacy.html [L]
