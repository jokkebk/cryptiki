{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptiki-v3-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-27",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
    { "name": "REQUEST_LIMITER", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
    // Keyed on the vault id alone, so guessing one vault cannot be spread across many addresses.
    { "name": "VAULT_LIMITER", "namespace_id": "3004", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cryptiki-v3-preview",
    "database_id": "09adb379-ec2b-40a9-9426-9dfc6d3e021e",
    "migrations_dir": "migrations"
  }]
}
